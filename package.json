{
  "name": "davgor-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "assert:dist": "node scripts/assert-dist-index.mjs dist/index.html",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run && vitest run --config fireguard/vitest.config.ts",
    "test:fireguard": "vitest run --config fireguard/vitest.config.ts",
    "fireguard": "tsx fireguard/src/main.ts",
    "test:e2e": "npx playwright test",
    "deploy": "npm run build && npm run assert:dist && echo \"Deploy via GitHub Actions only. Set Settings → Pages → Source to GitHub Actions, then push to main (or run workflow_dispatch).\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"fireguard/**/*.{ts,tsx,js,mjs,json}\" \".fireguardrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"fireguard/**/*.{ts,tsx,js,mjs,json}\" \".fireguardrc.json\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"fireguard/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"fireguard/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit && tsc --noEmit -p fireguard/tsconfig.json",
    "deadcode": "npx -y ts-prune --project tsconfig.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "src/**/*.{js,jsx,json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.33.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jimp": "^1.6.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.2.0",
    "minimatch": "^10.2.6",
    "prettier": "^3.8.1",
    "tsx": "^4.23.11",
    "typescript": "^5.2.2",
    "uuid": "^11.1.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
